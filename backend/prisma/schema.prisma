// NAWASENA Center - Prisma Schema
// PostgreSQL via Supabase. Pooling (DATABASE_URL) untuk runtime, Direct (DIRECT_URL) untuk migrate.
// Auth tetap Supabase Auth (tabel auth.users dikelola Supabase, di sini hanya mirror via profiles).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// INTERNAL / PROGRAM
// ============================================================

model Profile {
  id        String   @id @db.Uuid
  email     String?  @unique
  fullName  String?  @map("full_name")
  role      String   @default("operator")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  news News[]
  musimTanam MusimTanam[]

  @@map("profiles")
}

model Device {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @unique @map("device_id")
  type      String
  name      String?
  status    String   @default("offline")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  telemetry      Telemetry[]
  trapEvents     TrapEvent[]
  roverOps       RoverOperation[]

  @@map("devices")
}

model Telemetry {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id")
  payload   Json
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  device Device? @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId, recordedAt])
  @@map("telemetry")
}

model TrapEvent {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id")
  eventType String   @map("event_type")
  data      Json?
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  device Device? @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId, recordedAt])
  @@map("trap_events")
}

model RoverOperation {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id")
  lat       Float?
  lng       Float?
  heading   Float?
  gpsFix    Boolean? @map("gps_fix")
  sats      Int?
  status    String?
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  device Device? @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId, recordedAt])
  @@map("rover_operations")
}

model FieldSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  farmerName  String   @map("farmer_name")
  fieldName   String?  @map("field_name")
  padukuhan   String?
  plantDate   DateTime @map("plant_date") @db.Date
  estimatedHarvest DateTime? @map("estimated_harvest") @db.Date
  status      String   @default("planned")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  notifications Notification[]

  @@map("field_schedules")
}

model HarvestRecord {
  id           String   @id @default(uuid()) @db.Uuid
  farmerName   String   @map("farmer_name")
  fieldName    String?  @map("field_name")
  ubinanKg     Float    @map("ubinan_kg")
  areaHa       Float    @map("area_ha")
  yieldTonHa   Float?   @map("yield_ton_ha")
  estimatedKg  Float?   @map("estimated_kg")
  pestLossPct  Float?   @map("pest_loss_pct")
  scheduleId   String?  @map("schedule_id") @db.Uuid
  padukuhan    String?
  harvestDate  DateTime @map("harvest_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("harvest_records")
}

model LogbookEntry {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String?
  category  String?
  authorId  String?  @map("author_id") @db.Uuid
  entryDate DateTime @map("entry_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("logbook_entries")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String?  @map("schedule_id") @db.Uuid
  channel    String   @default("whatsapp")
  target     String?
  message    String
  status     String   @default("pending")
  sentAt     DateTime? @map("sent_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  schedule FieldSchedule? @relation(fields: [scheduleId], references: [id])

  @@map("notifications")
}

// ============================================================
// PUBLIC CONTENT
// ============================================================

model News {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverUrl    String?   @map("cover_url")
  category    String?
  author      String?
  status      String    @default("draft")
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  authorId    String?   @map("author_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  authorProfile Profile? @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@map("news")
}

model Umkm {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  ownerName      String?  @map("owner_name")
  description    String?
  category       String?
  coverUrl       String?  @map("cover_url")
  contactPhone   String?  @map("contact_phone")
  contactAddress String?  @map("contact_address")
  products       Json?
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([category])
  @@map("umkm")
}

// Profil KALURAHAN (level keseluruhan desa, singleton -- 1 baris).
// Dilengkapi lurahName supaya sambutan Lurah bisa tampil terpisah
// dari sambutan tiap Kepala Dukuh (lihat model Padukuhan di bawah).
model VillageProfile {
  id          String   @id @default(uuid()) @db.Uuid
  lurahName   String?  @map("lurah_name")
  vision      String?
  mission     String?
  description String?
  potency     Json?
  stats       Json?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("village_profile")
}

// Galeri foto level KALURAHAN (umum, tidak terikat padukuhan
// tertentu -- mis. foto balai desa, kantor kalurahan).
model VillageGallery {
  id         String   @id @default(uuid()) @db.Uuid
  imageUrl   String   @map("image_url")
  caption    String?
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("village_gallery")
}

// Satu baris PER PADUKUHAN (rencana 6 total, mulai dari 1 --
// Karangtengah -- yang lain ditambah manual via CMS begitu datanya
// tersedia). hasData jadi flag frontend: true = tampilkan penuh,
// false = tampilkan "Segera Hadir" tanpa perlu hapus/sembunyikan
// baris-nya dari daftar.
model Padukuhan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  kepalaDukuh String?  @map("kepala_dukuh")
  sambutan    String?
  description String?
  hasData     Boolean  @default(false) @map("has_data")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  gallery PadukuhanGallery[]

  @@map("padukuhan")
}

model PadukuhanGallery {
  id          String   @id @default(uuid()) @db.Uuid
  padukuhanId String   @map("padukuhan_id") @db.Uuid
  imageUrl    String   @map("image_url")
  caption     String?
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  padukuhan Padukuhan @relation(fields: [padukuhanId], references: [id], onDelete: Cascade)

  @@index([padukuhanId])
  @@map("padukuhan_gallery")
}

// Asumsi dasar perhitungan Dampak Ekonomi program NAWASENA (dipakai
// halaman publik Pertanian > Dampak Ekonomi). Struktur field di sini
// disamakan PERSIS dengan tabel yang sudah ada di database Anda --
// jangan ubah tipe data / nama kolom tanpa migrasi terpisah.
model AsumsiEkonomi {
  id                   String   @id @default(uuid()) @db.Uuid
  berlakuSejak         DateTime @map("berlaku_sejak") @db.Date
  kerugianBaselineMin  Float    @map("kerugian_baseline_min")
  kerugianBaselineMaks Float    @map("kerugian_baseline_maks")
  kerugianTarget       Float    @map("kerugian_target")
  hargaGabahPerKg      Int      @map("harga_gabah_per_kg")
  luasPilotHa          Float    @map("luas_pilot_ha")
  luasTotalHa          Float    @map("luas_total_ha")
  padukuhanPilot       String   @map("padukuhan_pilot")
  sumber               Json
  dicatatOleh          String   @map("dicatat_oleh")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("asumsi_ekonomi")
}

// ============================================================
// PLANTING SCHEDULE (Jadwal Tanam)
// ============================================================

enum StatusMusimTanam {
  DRAFT
  AKTIF
  SELESAI
}

model Komoditas {
  id        String   @id @default(uuid()) @db.Uuid
  nama      String
  deskripsi String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  musimTanam MusimTanam[]

  @@map("komoditas")
}

model MusimTanam {
  id             String           @id @default(uuid()) @db.Uuid
  judul          String
  komoditasId    String           @map("komoditas_id") @db.Uuid
  lokasi         String?
  tanggalMulai   DateTime?        @map("tanggal_mulai") @db.Timestamptz
  tanggalSelesai DateTime?        @map("tanggal_selesai") @db.Timestamptz
  status         StatusMusimTanam @default(DRAFT)
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  komoditas  Komoditas       @relation(fields: [komoditasId], references: [id])
  createdBy  Profile?        @relation(fields: [createdById], references: [id])
  tahapan    TahapanJadwal[]

  @@index([status])
  @@map("musim_tanam")
}

model TahapanJadwal {
  id             String    @id @default(uuid()) @db.Uuid
  musimTanamId   String    @map("musim_tanam_id") @db.Uuid
  namaTahapan    String    @map("nama_tahapan")
  tanggalMulai   DateTime  @map("tanggal_mulai") @db.Timestamptz
  tanggalSelesai DateTime? @map("tanggal_selesai") @db.Timestamptz
  urutan         Int
  deskripsi      String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  musimTanam MusimTanam @relation(fields: [musimTanamId], references: [id], onDelete: Cascade)

  @@index([musimTanamId, urutan])
  @@map("tahapan_jadwal")
}
