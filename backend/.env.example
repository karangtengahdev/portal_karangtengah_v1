# ============ DATABASE (Supabase PostgreSQL via Prisma) ============
# Pooling - untuk query runtime aplikasi (port 6543, pgbouncer)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct - untuk migrate & seed (port 5432)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ============ SUPABASE (Auth JWKS + Storage) ============
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_ANON_KEY="eyJ..."
# JWKS endpoint untuk verifikasi JWT ES256 (otomatis dari SUPABASE_URL)
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json

# ============ STORAGE ============
STORAGE_BUCKET="public-content"

# ============ APP ============
PORT=3000
NODE_ENV=development

# ============ BRIDGE (telemetry ingest) ============
BRIDGE_API_KEY="ganti-dengan-key-acak-rotasi-berkala"

# ============ WHATSAPP (seam notifikasi, isi nanti) ============
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
